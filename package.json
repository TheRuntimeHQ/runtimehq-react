{
  "name": "@theruntimehq/react",
  "version": "0.2.2",
  "description": "Official React SDK for RuntimeHQ status checking and monitoring.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "runtimehq",
    "status",
    "monitoring",
    "sdk",
    "react",
    "hooks"
  ],
  "author": "RuntimeHQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheRuntimeHQ/runtimehq-react.git"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@theruntimehq/js": "^0.2.2"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.3",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  }
}
